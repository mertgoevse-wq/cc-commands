#!/usr/bin/env bash
# cc-nim — Claude Code über NVIDIA NIM (build.nvidia.com, gratis Trial-Tier) starten.
# NIM ist OpenAI-Format; die Anthropic->OpenAI-Übersetzung übernimmt claude-code-router
# (ccr) als lokale Bridge auf http://127.0.0.1:3456.
#
#   cc-nim                 Modelle listen (mit Live-Status) + auswählen + starten
#   cc-nim list [muster]   nur listen (Optional: grep-Muster, z. B. 'llama|qwen|kimi')
#   cc-nim <modell> [claude-args...]
#   cc-nim help

set -u
BASE="https://integrate.api.nvidia.com/v1"
KEY_FILE="${NIM_KEY_FILE:-$HOME/.cc-providers/nim.key}"

[ -r "$KEY_FILE" ] || { echo "Fehler: Kein NVIDIA-Key in $KEY_FILE" >&2; exit 1; }
KEY="$(tr -d '\r\n' < "$KEY_FILE")"

fetch_ids() {
    curl -sS --max-time 40 "$BASE/models" -H "Authorization: Bearer $KEY" \
        | node "$HOME/bin/cc-json-ids.js" 2>/dev/null
}

probe_one() {   # exportiert, wird via xargs parallel aufgerufen; setzt KEY/BASE voraus
    local m="$1" code body
    body='{"model":"'"$m"'","messages":[{"role":"user","content":"hi"}],"max_tokens":1}'
    code=$(curl -sS --max-time 15 -o /dev/null -w '%{http_code}' \
        -H "Authorization: Bearer $KEY" -H "Content-Type: application/json" \
        -X POST "$BASE/chat/completions" -d "$body" 2>/dev/null)
    printf '%s\t%s\n' "$m" "$code"
}

status_mark() { # HTTP-Code -> Anzeige
    case "$1" in
        20*) echo "✓" ;;
        429) echo "!" ;;          # Rate-Limit (Gratis-Tier): Modell da, gerade gedrosselt
        401|403|404) echo "✗" ;;  # Key/Rechte/Modell fehlt
        400) echo "?" ;;          # Anfrage-Regression/Sonderregeln — unsicher
        5*)  echo "?" ;;          # Upstream-Störung
        000|*) echo "?" ;;        # Timeout/sonstiges
    esac
}

# show_models [muster] — lädt Modell-IDs (optional grep-gefiltert), probe je Modell
# parallel und füllt MODELS[] + ST[] (assoziativ) sowie Liste mit OK-Spalte.
show_models() {
    local pattern="${1:-.}"
    mapfile -t MODELS < <(fetch_ids | grep -iE "$pattern" || true)
    [ "${#MODELS[@]}" -gt 0 ] || { echo "Keine Modelle von NIM erhalten — Key prüfen." >&2; return 1; }
    export KEY BASE
    export -f probe_one 2>/dev/null || true
    declare -gA ST
    while IFS=$'\t' read -r id code; do
        ST["$id"]="$(status_mark "$code")"
    done < <(printf '%s\n' "${MODELS[@]}" | xargs -d '\n' -P 10 -n1 bash -c 'probe_one "$0"' 2>/dev/null)
    local i=1
    printf '%-4s %-2s %s\n' "Nr." "OK" "Modell"
    for m in "${MODELS[@]}"; do
        printf '%-4d %-2s %s\n' "$i" "${ST[$m]:-?}" "$m"
        i=$((i + 1))
    done
    echo "(✓ = jetzt erreichbar; ! = Rate-Limit; ✗ = nicht verfügbar; ? = unsicher, z. B. Timeout)"
    return 0
}

ensure_gateway() {
    if curl -sS --max-time 2 -o /dev/null "http://127.0.0.1:3456/" 2>/dev/null; then
        return 0
    fi
    echo "→ Starte lokale ccr-Bridge (Anthropic->OpenAI) auf Port 3456 ..." >&2
    command -v ccr >/dev/null 2>&1 || {
        echo "Fehler: ccr (claude-code-router) nicht gefunden. Install: npm i -g @musistudio/claude-code-router" >&2
        return 1
    }
    ccr start >/dev/null 2>&1 &
    local i
    for i in $(seq 1 20); do
        if curl -sS --max-time 2 -o /dev/null "http://127.0.0.1:3456/" 2>/dev/null; then
            return 0
        fi
        sleep 1
    done
    echo "Fehler: ccr-Gateway startet nicht (ccr start manuell prüfen)." >&2
    return 1
}

start_claude() {
    local model="$1"; shift
    node "$HOME/bin/cc-config.js" upsert nvidia-nim "$BASE/chat/completions" "$KEY" "$model" >/dev/null \
        || { echo "Fehler beim Schreiben der ccr-Config." >&2; exit 1; }
    node "$HOME/bin/cc-config.js" default "nvidia-nim,$model" >/dev/null
    ensure_gateway || exit 1
    export ANTHROPIC_BASE_URL="http://127.0.0.1:3456"
    export ANTHROPIC_AUTH_TOKEN="sk-ccr-local"
    export ANTHROPIC_API_KEY="sk-ccr-local"
    unset ANTHROPIC_MODEL
    echo "→ Starte Claude Code via NVIDIA NIM (Gratis-Tier, ccr-Bridge) — Modell: $model"
    exec claude --model "nvidia-nim,$model" "$@"
}

pick_and_start() {
    show_models || exit 1
    echo "(${#MODELS[@]} NIM-Modelle; Status = Live-Probe mit 1 Mini-Request)"
    printf 'Modell wählen (Nummer oder Name): '
    read -r CHOICE
    [ -n "$CHOICE" ] || { echo "Abgebrochen." >&2; exit 1; }
    if case "$CHOICE" in (*[!0-9]*|'') false;; esac && [ "$CHOICE" -ge 1 ] && [ "$CHOICE" -le "${#MODELS[@]}" ]; then
        MODEL="${MODELS[$((CHOICE - 1))]}"
    else
        MODEL="$CHOICE"
    fi
    start_claude "$MODEL" "$@"
}

case "${1:-}" in
    list)
        shift
        show_models "${*:-.}" || exit 1
        ;;
    help|-h|--help)
        cat <<'USAGE'
cc-nim — Claude Code via NVIDIA NIM (OpenAI-Format -> ccr-Bridge)

  cc-nim                Modelle listen (mit Live-Status) + auswählen + starten
  cc-nim list [muster]  Liste anzeigen, optional mit grep-Muster (z. B. 'llama').
  cc-nim <modell>       Direkt starten (z. B. cc-nim meta/llama-3.3-70b-instruct)
  cc-nim <modell> args  Claude-Argumente durchreichen (z. B. -p "Frage")

Key:     ~/.cc-providers/nim.key
Bridge:  ccr (claude-code-router) auf http://127.0.0.1:3456 — wird von cc-nim
         automatisch gestartet, falls nötig. Manuell:  ccr start
         (Install falls fehlend: npm i -g @musistudio/claude-code-router)

Statusspalte: ✓ erreichbar | ! Rate-Limit | ✗ nicht verfügbar | ? unsicher
(Probe = 1 Mini-Request pro Modell, parallel)
USAGE
        ;;
    "")
        pick_and_start
        ;;
    -*)
        shift
        pick_and_start "$@"
        ;;
    *)
        start_claude "$@"
        ;;
esac
